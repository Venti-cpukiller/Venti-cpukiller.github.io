---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;

// 博客/作品是主页上的锚点区块（摄影归入作品大类）；关于是独立页
const nav = [
  { href: '/', label: '首页' },
  { href: '/#blog', label: '博客' },
  { href: '/#works', label: '作品' },
  { href: '/about/', label: '关于' },
];

const current = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return current === '/' ? 'page' : undefined;
  if (href.includes('#') || !href.startsWith('/')) return undefined;
  return current.startsWith(href) ? 'page' : undefined;
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      // 页面绘制前先定好主题，避免刷新时闪一下错误的配色；
      // 跨页导航（astro:after-swap）后再应用一次，防止主题丢失
      const applyTheme = () => {
        const saved = localStorage.getItem('theme');
        const theme =
          saved ??
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      };
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href="/">{SITE.title}</a>
        <nav class="site-nav" aria-label="主导航">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换深色 / 浅色模式"></button>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          © {new Date().getFullYear()} {SITE.author} · 用
          <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 搭建
        </p>
        <p>
          托管于 GitHub Pages 与 Cloudflare Pages ·
          <a href="/rss.xml">RSS 订阅</a>
        </p>
        <p class="contact-line">
          联系我：
          {
            SITE.contact.map((c, i) => (
              <>
                <span class="contact-item">
                  {c.href ? (
                    <a
                      href={c.href}
                      target={c.href.startsWith('http') ? '_blank' : undefined}
                      rel="noopener"
                    >
                      {c.label}：{c.value}
                    </a>
                  ) : (
                    `${c.label}：${c.value || '待补'}`
                  )}
                </span>
                {i < SITE.contact.length - 1 && ' · '}
              </>
            ))
          }
        </p>
      </div>
    </footer>

    <!-- 音乐元素跨页持久存在（配合 ClientRouter），切换页面时音乐不断 -->
    <audio id="bgm" src="/audio/bgm.m4a" loop preload="none" transition:persist="bgm"></audio>
    <button id="bgm-toggle" class="bgm-toggle" type="button" aria-label="播放 / 暂停背景音乐" title="背景音乐">♪</button>

    <script>
      // astro:page-load 在首次加载和每次跨页导航后都会触发：
      // 给「当前页面」的按钮重新绑定事件（音频元素本身是持久的，不用重绑）
      document.addEventListener('astro:page-load', () => {
        // 主题切换
        const btn = document.getElementById('theme-toggle') as HTMLButtonElement;
        const setIcon = () => {
          btn.textContent =
            document.documentElement.dataset.theme === 'dark' ? '☀️' : '🌙';
        };
        setIcon();
        btn.onclick = () => {
          const next =
            document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          localStorage.setItem('theme', next);
          setIcon();
        };

        // 背景音乐按钮：按音频元素的真实状态同步外观
        const bgm = document.getElementById('bgm') as HTMLAudioElement;
        const bgmBtn = document.getElementById('bgm-toggle') as HTMLButtonElement;
        const syncBtn = () => {
          bgmBtn.classList.toggle('playing', !bgm.paused);
          // 暂停时显示播放三角，播放中显示双竖条
          bgmBtn.textContent = bgm.paused ? '▶︎' : '❚❚';
        };
        syncBtn();
        bgmBtn.onclick = () => {
          if (bgm.paused) {
            bgm.play().catch(() => {});
          } else {
            bgm.pause();
            // 用户主动停掉，就不再自动续播
            sessionStorage.removeItem('bgm-want');
          }
          syncBtn();
        };

        // 加载失败时静默隐藏按钮（音频元素跨页持久，绑定一次即可）
        if (!bgm.dataset.errBound) {
          bgm.dataset.errBound = '1';
          bgm.addEventListener('error', () => {
            bgmBtn.style.display = 'none';
          });
          // 真正响起后确认「想听」已满足，撕掉标志牌
          bgm.addEventListener('playing', () => {
            sessionStorage.removeItem('bgm-want');
          });
        }

        // 「想听」标志还挂着 → 换页完成后无脑再试 play()：
        // 对正在播的元素是无害空操作；对被换页打断的则完成续播
        if (sessionStorage.getItem('bgm-want') === '1') {
          bgm.play().catch(() => {
            // 瞬时激活窗口已过期时，挂一次性点击兜底
            document.addEventListener(
              'click',
              () => document.getElementById('bgm')?.play().catch(() => {}),
              { once: true },
            );
          });
        }

        // 跨页锚点：路由换页后确保滚到目标区块（浏览器偶尔不自动滚）
        if (location.hash) {
          requestAnimationFrame(() => {
            document
              .querySelector(location.hash)
              ?.scrollIntoView({ behavior: 'smooth' });
          });
        }
      });

      // 断点续播：记住播放位置；刷新/下次访问后从上次的位置接着播
      {
        const bgm0 = document.getElementById('bgm');
        const savedTime = parseFloat(localStorage.getItem('bgm-time') || '0');
        if (bgm0 && savedTime > 0) {
          bgm0.addEventListener(
            'loadedmetadata',
            () => {
              try {
                bgm0.currentTime = savedTime;
              } catch {
                /* 恢复失败就从头播，无所谓 */
              }
            },
            { once: true },
          );
        }
        if (bgm0) {
          bgm0.addEventListener('timeupdate', () => {
            try {
              localStorage.setItem('bgm-time', String(bgm0.currentTime));
            } catch {
              /* 忽略写入失败 */
            }
          });
        }
      }

      // 自动播放：每个浏览器会话只尝试一次；被浏览器策略拦截时，
      // 等访客第一次点击页面任意处再开始播放
      if (!sessionStorage.getItem('bgm-started')) {
        sessionStorage.setItem('bgm-started', '1');
        const tryPlay = () => {
          const bgm = document.getElementById('bgm');
          if (!bgm) return;
          bgm.play().catch(() => {
            sessionStorage.setItem('bgm-want', '1');
            document.addEventListener(
              'click',
              () => {
                sessionStorage.setItem('bgm-want', '1');
                document.getElementById('bgm')?.play().catch(() => {});
              },
              { once: true },
            );
          });
        };
        tryPlay();
      }
    </script>
  </body>
</html>
