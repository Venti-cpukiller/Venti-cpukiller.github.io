---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import { photos } from '../../data/photos';
import { SITE } from '../../consts';

export function getStaticPaths() {
  return photos.map((p, i) => ({
    params: { slug: p.slug },
    props: {
      photo: p,
      prev: photos[(i - 1 + photos.length) % photos.length],
      next: photos[(i + 1) % photos.length],
    },
  }));
}

const { photo, prev, next } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/photos/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const img = images['../../assets/photos/' + photo.file.replace('./', '')];
---

<Base title={`${photo.caption} · 摄影 · ${SITE.title}`} description={photo.caption}>
  <article class="article">
    <div class="feed-head">
      <img
        class="feed-avatar"
        src="/img/avatar.jpg"
        alt={SITE.author}
        width="40"
        height="40"
      />
      <div class="feed-author">
        <span class="feed-name">{SITE.author}</span>
        <time class="feed-date">{photo.date}</time>
      </div>
      <button
        id="like-btn"
        class="like-btn"
        type="button"
        data-id={photo.slug}
        aria-label="点赞这张照片"
      >
        <span class="like-glyph" aria-hidden="true">♥</span>
        <span class="like-count" id="like-count">…</span>
      </button>
    </div>
    <div class="polaroid">
      <div class="polaroid-img">
        {
          img && (
            <Image
              src={img.default}
              alt={photo.alt}
              widths={[800, 1600]}
              sizes="(max-width: 900px) 92vw, 62rem"
              loading="eager"
              decoding="async"
            />
          )
        }
      </div>
      <p class="polaroid-caption">{photo.caption}</p>
    </div>
    <nav class="photo-nav">
      {
        prev && (
          <a href={`/photos/${prev.slug}/`}>← {prev.caption}</a>
        )
      }
      {
        next && (
          <a class="photo-nav-next" href={`/photos/${next.slug}/`}>
            {next.caption} →
          </a>
        )
      }
    </nav>
    <a class="back" href="/photos/">← 返回摄影</a>
    <Comments />
  </article>
  <script>
    // 匿名点赞：Cloudflare Worker + KV 计数，无登录；localStorage 记住本机是否已赞
    const API_BASE = 'https://venti-likes.1913554056.workers.dev/api';
    const btn = document.getElementById('like-btn') as HTMLButtonElement;
    const countEl = document.getElementById('like-count') as HTMLElement;
    const id = btn.dataset.id as string;
    const likedKey = 'liked-photo-' + id;

    const setLiked = (liked: boolean) =>
      btn.classList.toggle('liked', liked);
    setLiked(localStorage.getItem(likedKey) === '1');

    btn.onclick = async () => {
      const liked = localStorage.getItem(likedKey) === '1';
      const ep = liked ? '/unlike/' : '/like/';
      btn.disabled = true;
      try {
        const r = await fetch(API_BASE + ep + id, { method: 'POST' });
        const d = await r.json();
        countEl.textContent = String(d.count);
        if (liked) {
          localStorage.removeItem(likedKey);
        } else {
          localStorage.setItem(likedKey, '1');
        }
        setLiked(!liked);
      } catch (e) {
        /* 网络失败时静默，保持原状 */
      }
      btn.disabled = false;
    };

    fetch(API_BASE + '/like/' + id)
      .then((r) => r.json())
      .then((d) => {
        countEl.textContent = String(d.count);
      })
      .catch(() => {
        btn.style.display = 'none';
      });
  </script>
</Base>
