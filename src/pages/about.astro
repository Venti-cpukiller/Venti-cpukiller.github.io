---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
---

<Base title={`关于 · ${SITE.title}`} description={`关于 ${SITE.author}`}>
  <article class="article">
    <h1>关于我</h1>
    <div class="prose">
      <p>
        你好，我是 {SITE.author}。（这是一段占位介绍——改成你自己的：
        你是谁、在做什么、感兴趣什么。）
      </p>
      <h2>我在折腾</h2>
      <ul>
        <li>写点代码，搭点小工具</li>
        <li>记录学习和生活</li>
        <li>……（在这里补充）</li>
      </ul>
      <h2>找到我</h2>
      <p>
        {SITE.socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener">{s.label}</a>
        ))}
        <!-- 可以在中间补一些分隔，或改成一行一段 -->
      </p>
    </div>
  </article>
</Base>
