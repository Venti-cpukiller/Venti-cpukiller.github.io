---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const featuredWorks = (await getCollection('works'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base>
  <section class="hero">
    <h1>你好，我是 {SITE.author} 👋</h1>
    <p class="hero-intro">
      一个爱好广泛的家伙：耳机不离身的音乐爱好者、快门闲不住的摄影新手、
      二游深度玩家，最近又开始对写代码上头。喜欢一切好玩的东西，
      更喜欢亲手把它们造出来。这个站收藏我的文字、作品和快门瞬间——慢慢逛，别着急。
    </p>
    <div class="hero-links">
      {SITE.socials.map((s) => (
        <a class="chip" href={s.href} target="_blank" rel="noopener">{s.label} ↗</a>
      ))}
    </div>
  </section>

  <section id="blog" class="home-section">
    <div class="section-head">
      <h2>最近的文章</h2>
      <a class="more" href="/blog/">全部文章 →</a>
    </div>
    <ul class="post-list">
      {latestPosts.map((post) => (
        <li>
          <a class="post-item" href={`/blog/${post.id}/`}>
            <div class="post-main">
              <span class="post-title">{post.data.title}</span>
              {post.data.description && (
                <span class="post-desc">{post.data.description}</span>
              )}
            </div>
            <time class="post-date" datetime={post.data.date.toISOString()}>
              {post.data.date.toISOString().slice(0, 10)}
            </time>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="works" class="home-section">
    <div class="section-head">
      <h2>精选作品</h2>
      <a class="more" href="/works/">全部作品 →</a>
    </div>
    <div class="card-grid">
      {featuredWorks.map((work) => (
        <a class="card" href={`/works/${work.id}/`}>
          <span class="card-icon">{work.data.icon}</span>
          <h3>{work.data.title}</h3>
          <p>{work.data.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section id="photo" class="home-section">
    <div class="section-head">
      <h2>摄影</h2>
    </div>
    <div class="photo-placeholder">
      <span class="photo-icon">📷</span>
      <p>摄影作品整理中——这里以后会挂上我的快门瞬间。</p>
    </div>
  </section>
</Base>
