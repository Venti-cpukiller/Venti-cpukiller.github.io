---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const featuredWorks = (await getCollection('works'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base>
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-text">
        <h1>你好，我是 {SITE.author} 👋</h1>
        <p class="hero-footnote">Venti 并非我本名，该名字来自《原神》的温迪。</p>
        <p class="hero-intro">
          昆明理工大学机器人工程苦逼大二学生，爱好广泛得有点过分：
          耳机不离身的音乐爱好者、玩 CCD 快六年的摄影老手（正在攒钱升级微单）、
          二游深度玩家、骑车看地图的地理人文爱好者、语言学好奇者，
          最近又对写代码上了头。喜欢一切好玩的东西，更喜欢亲手把它们造出来。
          这个站收藏我的文字、作品和快门瞬间——慢慢逛，别着急。
        </p>
        <div class="hero-links">
          {SITE.socials.map((s) => (
            <a class="chip" href={s.href} target="_blank" rel="noopener">{s.label} ↗</a>
          ))}
        </div>
      </div>
      <div class="hero-avatar">
        <img src="/img/avatar.jpg" alt="Venti 的头像" width="220" height="220" loading="eager" />
      </div>
    </div>
  </section>

  <!-- 绝区零风：滚动横幅（其他风格下自动隐藏） -->
  <div class="zzz-marquee" aria-hidden="true">
    <span>欢迎光临 ★ VENTI'S SITE ★ 机器人工程在读 ★ CCD 六年老手 ★ 音乐循环中 ★ 骑行看世界 ★ 语言学好奇 ★ 二游深潜 ★ 折腾永不停 ★ </span>
    <span>欢迎光临 ★ VENTI'S SITE ★ 机器人工程在读 ★ CCD 六年老手 ★ 音乐循环中 ★ 骑行看世界 ★ 语言学好奇 ★ 二游深潜 ★ 折腾永不停 ★ </span>
  </div>

  <section id="blog" class="home-section">
    <div class="section-head">
      <h2>最近的文章</h2>
      <a class="more" href="/blog/">全部文章 →</a>
    </div>
    <ul class="post-list">
      {latestPosts.map((post) => (
        <li>
          <a class="post-item" href={`/blog/${post.id}/`}>
            <div class="post-main">
              <span class="post-title">{post.data.title}</span>
              {post.data.description && (
                <span class="post-desc">{post.data.description}</span>
              )}
            </div>
            <time class="post-date" datetime={post.data.date.toISOString()}>
              {post.data.date.toISOString().slice(0, 10)}
            </time>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="works" class="home-section">
    <div class="section-head">
      <h2>作品</h2>
      <a class="more" href="/works/">全部作品 →</a>
    </div>

    <!-- 分类一：项目。
         以后想加新分类（设计、视频、写作……），照这一块的结构复制一份：
         <div class="work-category"> <h3>分类名</h3> 内容 </div> -->
    <div class="work-category">
      <h3>项目</h3>
      <div class="card-grid">
        {featuredWorks.map((work) => (
          <a class="card" href={`/works/${work.id}/`}>
            <span class="card-icon">{work.data.icon}</span>
            <h3>{work.data.title}</h3>
            <p>{work.data.description}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- 分类二：摄影 -->
    <div class="work-category">
      <h3>摄影</h3>
      <div class="photo-placeholder">
        <span class="photo-icon">📷</span>
        <p>摄影作品整理中——这里以后会挂上我的快门瞬间。</p>
      </div>
    </div>
  </section>
</Base>
