---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title={`博客 · ${SITE.title}`} description={`${SITE.author} 的博客文章列表`}>
  <h1 class="page-title">博客</h1>
  <div class="feed">
    {
      posts.map((post) => (
        <article class="feed-card">
          <div class="feed-head">
            <img class="feed-avatar" src="/img/avatar.jpg" alt={SITE.author} width="40" height="40" />
            <div class="feed-author">
              <span class="feed-name">{SITE.author}</span>
              <time class="feed-date" datetime={post.data.date.toISOString()}>
                {post.data.date.toISOString().slice(0, 10)}
              </time>
            </div>
            {post.data.tags.length > 0 && (
              <span class="tags feed-tags">
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </span>
            )}
          </div>
          <a class="feed-cover" href={`/blog/${post.id}/`} aria-label={post.data.title}>
            {post.data.cover ? (
              <img src={post.data.cover} alt={`${post.data.title} 封面图`} loading="lazy" />
            ) : (
              <div class="feed-cover-fallback" aria-hidden="true">✦</div>
            )}
          </a>
          <div class="feed-body">
            <h2 class="feed-title">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            {post.data.description && <p class="feed-desc">{post.data.description}</p>}
            <a class="more" href={`/blog/${post.id}/`}>阅读全文 →</a>
          </div>
        </article>
      ))
    }
  </div>
</Base>
